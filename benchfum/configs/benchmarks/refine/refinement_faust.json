{
  "_name": "Refinement FAUST Benchmark",
  "_description": "Benchmark suite for refinement methods on FAUST. All methods share the same base matcher; differences come only from the refiner.",
  "dataset": {
    "root": "../../../../datasets/dummy_faust/test_set",
    "k": 200
  },
  "base_matcher_config": "../matchers/fmap.json",
  "methods": [
    {
      "name": "No Refinement",
      "refiner_config": "../../refiners/identity.json"
    },
    {
      "name": "ICP",
      "refiner_config": "../../refiners/icp.json"
    },
    {
      "name": "ZoomOut",
      "refiner_config": "../../refiners/zoomout.json"
    },
    {
      "name": "ICP+ZoomOut",
      "refiner_config": "../../refiners/icp_zoomout.json"
    }
  ],
  "metrics": ["geodesic_error"],
  "bidirectional": false,
  "n_pairs": null
}
