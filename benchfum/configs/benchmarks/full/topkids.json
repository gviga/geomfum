{
  "_name": "TOPKIDS benchmark",
  "_description": "Full-shape matching on TOPKIDS (26 kid body scans).",

  "dataset": {
    "type": "TopKidsDataset",
    "root": null,
    "spectral": true,
    "k": 200,
    "distances": true
  },

  "metrics": ["geodesic_error"],

  "methods": [
    {
      "name": "WKS",
      "matcher_config": "../../matchers/features_only/wks.json"
    },
    {
      "name": "FMap+WKS",
      "matcher_config": "../../matchers/functional_maps/fmap_wks.json"
    },
    {
      "name": "FMap+WKS+ZO",
      "matcher_config": "../../matchers/functional_maps/fmap_zo.json"
    }
  ]
}
