{
  "_name": "DT4D_r inter-class benchmark",
  "_description": "Full-shape matching on DT4D remeshed using only cross-category pairs listed in cross_category_corres.",

  "dataset": {
    "type": "DT4DPairsDataset",
    "root": null,
    "_note": "Inter-class mode: only category pairs with cross-category reference maps are used.",
    "phase": "test",
    "inter_class": true,
    "spectral": true,
    "k": 200,
    "_ignored_categories_default": ["pumpkinhulk"]
  },

  "n_pairs": 1000,

  "metrics": ["euclidean_error"],

  "methods": [
    {
      "name": "WKS",
      "matcher_config": "../../matchers/features_only/wks.json"
    },
    {
      "name": "FMap+WKS",
      "matcher_config": "../../matchers/functional_maps/fmap_wks.json"
    }
  ]
}
