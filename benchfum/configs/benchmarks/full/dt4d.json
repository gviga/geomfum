{
  "_name": "DT4D_r benchmark",
  "_description": "Full-shape matching on DT4D remeshed (524 meshes across 9 character categories).",

  "dataset": {
    "type": "DT4DDataset",
    "root": null,
    "_note": "DT4DDataset yields per-shape corr-to-reference. Evaluation uses both corr arrays.",
    "spectral": true,
    "k": 200,
    "distances": false,
    "_ignored_categories_default": ["pumpkinhulk"]
  },

  "n_pairs": 1000,

  "metrics": ["geodesic_error"],

  "methods": [
    {
      "name": "WKS",
      "matcher_config": "../../matchers/features_only/wks.json"
    },
    {
      "name": "FMap+WKS",
      "matcher_config": "../../matchers/functional_maps/fmap_wks.json"
    }
  ]
}
