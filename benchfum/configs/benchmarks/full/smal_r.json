{
  "_name": "SMAL_r benchmark",
  "_description": "Full-shape matching on SMAL remeshed (standard shapes/ layout).",

  "dataset": {
    "root": null,
    "_note": "SMAL_r: shapes in off/, correspondences in corres/ (1-indexed .vts).",
    "spectral": true,
    "k": 200,
    "distances": true,
    "correspondences": true,
    "shapes_subdir": "off",
    "corr_subdir": "corres",
    "corr_offset": 1
  },

  "metrics": ["geodesic_error"],

  "methods": [
    {
      "name": "WKS",
      "matcher_config": "../../matchers/features_only/wks.json"
    },
    {
      "name": "FMap+WKS",
      "matcher_config": "../../matchers/functional_maps/fmap_wks.json"
    },
    {
      "name": "FMap+WKS+ZO",
      "matcher_config": "../../matchers/functional_maps/fmap_zo.json"
    }
  ]
}
