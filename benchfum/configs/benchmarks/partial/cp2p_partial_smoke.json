{
  "_name": "CP2P partial smoke test",
  "_description": "Fast sanity check on CP2P partial-to-partial pairs with classical WKS+NN matcher.",
  "device": "cpu",

  "dataset": {
    "root": "../../../datasets/CP2P24/test",
    "format": "cp2p",
    "spectral": true,
    "k": 30
  },

  "train": false,
  "n_pairs": 5,

  "methods": [
    {
      "name": "WKS+NN (k=30)",
      "matcher_config": "../../matchers/features_only/wks_k30.json"
    }
  ],

  "metrics": ["OverlapIoU", "PCKMetric"]
}
