{
  "_name": "Unsupervised Precise",
  "_description": "10 epochs with full unsupervised loss suite including descriptor commutativity. Best unsupervised quality.",
  "optimizer": {"type": "Adam", "lr": 0.001, "weight_decay": 1e-5},
  "epochs": 10,
  "monitor_metric": "GeodesicError",
  "mode": "min",
  "train_loss_manager": {
    "type": "LossManager",
    "losses": [
      {"type": "OrthonormalityLoss", "weight": 1.0},
      {"type": "BijectivityLoss", "weight": 1.0},
      {"type": "LaplacianCommutativityLoss", "weight": 0.001},
      {"type": "DescriptorCommutativityLoss", "weight": 0.01}
    ]
  },
  "val_loss_manager": {
    "type": "LossManager",
    "losses": [
      {"type": "GeodesicError"}
    ]
  }
}
