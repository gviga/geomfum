{
  "_name": "Unsupervised Smoke (1 epoch)",
  "_description": "Minimal trainer config for quick pipeline sanity checks.",
  "optimizer": {"type": "Adam", "lr": 0.001, "weight_decay": 1e-5},
  "epochs": 1,
  "monitor_metric": "GeodesicError",
  "mode": "min",
  "train_loss_manager": {
    "type": "LossManager",
    "losses": [
      {"type": "OrthonormalityLoss", "weight": 1.0},
      {"type": "BijectivityLoss", "weight": 1.0}
    ]
  },
  "val_loss_manager": {
    "type": "LossManager",
    "losses": [
      {"type": "GeodesicError"}
    ]
  }
}
