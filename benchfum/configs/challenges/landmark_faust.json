{
  "_name": "Landmark-Based FAUST Benchmark",
  "_description": "Benchmark suite for matcher methods on FAUST using landmark-aware data. Add new methods by adding matcher configs and appending them to the methods list.",
  "dataset": {
    "root": "../../../../datasets/dummy_faust/test_set",
    "k": 200,
    "landmark_indices": [
      2959,
      2948,
      3116,
      5130,
      1252,
      4583,
      728
    ]
  },
  "methods": [
    {
      "name": "WKS+NN",
      "matcher_config": "../matchers/wks_nn.json"
    },
    {
      "name": "FunctionalMap",
      "matcher_config": "../matchers/fmap.json"
    },
    {
      "name": "FunctionalMap+ZO",
      "matcher_config": "../matchers/fmap_zo.json"
    },
    {
      "name": "LandmarkFunctionalMap",
      "matcher_config": "../matchers/lfmap.json"
    },
    {
      "name": "LandmarkFunctionalMap+ZO",
      "matcher_config": "../matchers/lfmap_zo.json"
    }
  ],
  "metrics": ["geodesic_error"],
  "bidirectional": false,
  "n_pairs": null
}
