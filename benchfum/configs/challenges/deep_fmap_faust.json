    },
    {
      "name": "RobustFMNet",
      "model_config": "../models/robust_fmnet_standard.json",
      "trainer_config": "../training/unsupervised_standard.json",
      "checkpoint": "../checkpoints/robust_fmnet_standard.pth"
    }
  ],
  "metrics": ["geodesic_error"],
  "bidirectional": false,
  "n_pairs": null
}
