{
  "_name": "Deep Functional Maps FAUST Benchmark",
  "_description": "Benchmark suite for deep functional-map methods on FAUST. Methods are defined by model and trainer JSON configs; users can add methods by appending entries in the methods list.",
  "train": true,
  "dataset": {
    "root": "../../../../datasets/dummy_faust/train_set",
    "train_root": "../../../../datasets/dummy_faust/train_set",
    "val_root": "../../../../datasets/dummy_faust/test_set",
    "k": 200
  },
  "methods": [
    {
      "name": "FMNet",
      "model_config": "../models/fmnet_standard.json",
      "trainer_config": "../training/unsupervised_standard.json"
    },
    {
      "name": "RobustFMNet",
      "model_config": "../models/robust_fmnet_standard.json",
      "trainer_config": "../training/unsupervised_standard.json"
    }
  ],
  "metrics": ["geodesic_error"],
  "bidirectional": false,
  "n_pairs": null
}
