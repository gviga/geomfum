{
  "_name": "RobustFMNet Large",
  "_description": "RobustFMNet with large DiffusionNet and SoftmaxNeighborFinder converter. Best accuracy.",
  "type": "RobustFMNet",
  "feature_extractor": {
    "type": "FeatureExtractor",
    "which": "diffusionnet",
    "k": 300,
    "in_channels": 256,
    "descriptor": {"type": "WaveKernelSignature", "n_domain": 200}
  },
  "fmap_module": {
    "type": "ForwardFunctionalMap",
    "lmbda": 1000.0,
    "resolvent_gamma": 1.0,
    "bijective": true
  },
  "converter": {
    "type": "P2pFromFmConverter",
    "neighbor_finder": {
      "type": "SoftmaxNeighborFinder",
      "n_neighbors": 1,
      "tau": 0.07
    }
  }
}
