{
  "_name": "FMNet Standard",
  "_description": "FMNet with standard DiffusionNet feature extractor. Recommended default.",
  "type": "FMNet",
  "feature_extractor": {
    "type": "FeatureExtractor",
    "which": "diffusionnet",
    "k": 200,
    "in_channels": 128,
    "descriptor": {"type": "WaveKernelSignature", "n_domain": 128}
  },
  "fmap_module": {
    "type": "ForwardFunctionalMap",
    "lmbda": 1000.0,
    "resolvent_gamma": 1.0,
    "bijective": true
  }
}
