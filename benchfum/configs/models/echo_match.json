{
  "_name": "EchoMatch (Xie et al., CVPR 2025)",
  "_description": "Partial-to-partial shape matching via correspondence reflection. Uses DiffusionNet features + bidirectional soft permutation (echo) matrices to jointly predict functional maps and per-vertex overlap scores.",
  "type": "EchoMatchNet",
  "feature_extractor": {
    "type": "FeatureExtractor",
    "which": "diffusionnet",
    "k": 128,
    "in_channels": 3,
    "out_channels": 128},
  "fmap_module": {
    "type": "ForwardFunctionalMap",
    "lmbda": 100.0,
    "resolvent_gamma": 0.5,
    "bijective": true
  },
  "converter": {
    "type": "P2pFromFmConverter",
    "neighbor_finder": {
      "type": "SoftmaxNeighborFinder",
      "n_neighbors": 1,
      "tau": 0.07
    }
  },
  "neighbor_finder": {
    "type": "SoftmaxNeighborFinder",
    "n_neighbors": 1,
    "tau": 0.10
  },
  "echo_scorer": {
    "type": "EchoScorer",
    "neighbor_size": 64
  },
  "overlap_refiner": {
    "type": "OverlapRefiner",
    "neighbor_size": 64,
    "feature_extractor": {
      "type": "FeatureExtractor",
      "which": "diffusionnet",
      "in_channels": 64,
      "out_channels": 1,
      "hidden_channels": 16,
      "n_block": 3,
      "k": 128,
      "dropout": false
    }
  }
}
