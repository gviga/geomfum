{
  "_description": "Fast functional map matcher. Small spectrum, minimal refinement. Use for quick experiments.",
  "type": "FunctionalMapMatcher",
  "fmap_size": 20,
  "descriptor_pipeline": {
    "type": "DescriptorPipeline",
    "steps": [
      {"type": "WaveKernelSignature", "n_domain": 200, "k": 200},
      {"type": "ArangeSubsampler", "subsample_step": 5},
      {"type": "L2InnerNormalizer"}
    ]
  },
  "fmap_optimizer": {
    "type": "FunctionalMapOptimizer",
    "factor_builders": [
      {"type": "SDPFactorBuilder", "weight": 1.0},
      {"type": "LBFactorBuilder", "weight": 0.01},
      {"type": "MultFactorBuilder", "weight": 0.1}
    ]
  },
  "refiner": {
    "type": "RefinementPipeline",
    "refiners": [
      {"type": "IcpRefiner", "nit": 5}
    ]
  }
}
