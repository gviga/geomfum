{
  "_name": "FMap",
  "_description": "Classic functional map with WKS descriptors, Landmark WKS descriptors, no refinement.",
  "type": "FunctionalMapMatcher",
  "fmap_size": 30,
  "descriptor_pipeline": {
    "type": "DescriptorPipeline",
    "steps": [
      {"type": "WaveKernelSignature", "n_domain": 200, "k": 200},
      {"type": "LandmarkWaveKernelSignature", "n_domain": 40, "k": 200},
      {"type": "ArangeSubsampler", "subsample_step": 10},
      {"type": "L2InnerNormalizer"}
    ]
  },
  "fmap_optimizer": {
    "type": "FunctionalMap",
    "factor_builders": [
      {"type": "SDPFactorBuilder", "weight": 1.0},
      {"type": "LBCFactorBuilder",  "weight": 0.01},
      {"type": "MultFactorBuilder", "weight": 0.1}
    ]
  },
  "refiner": {
    "type": "RefinementPipeline",
    "refiners": [
      {"type": "IdentityRefiner"}
    ]
  }
}
