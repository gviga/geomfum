{
  "_description": "Feature-based matcher using HKS descriptors and nearest-neighbour search.",
  "type": "FeatureMatcher",
  "descriptor_pipeline": {
    "type": "DescriptorPipeline",
    "steps": [
      {"type": "HeatKernelSignature", "n_domain": 200, "k": 200},
      {"type": "L2InnerNormalizer"},
      {"type": "ArangeSubsampler", "subsample_step": 10}
    ]
  }
}
