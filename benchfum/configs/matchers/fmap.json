{
  "_name": "FMap",
  "_description": "Classic functional map with WKS descriptors, no refinement, no landmarks.",
  "type": "FunctionalMapMatcher",
  "fmap_size": 30,
  "descriptor_pipeline": [
    {"type": "WaveKernelSignature", "n_domain": 200, "k": 200},
    {"type": "ArangeSubsampler", "subsample_step": 10},
    {"type": "L2InnerNormalizer"}
  ],
  "fmap_optimizer": {
    "factors": [
      {"type": "SDPFactorBuilder", "weight": 1.0},
      {"type": "LBFactorBuilder",  "weight": 0.01},
      {"type": "MultFactorBuilder","weight": 0.1}
    ]
  },
  "refiner": [
    {"type": "IdentityRefiner"}
  ]
}
